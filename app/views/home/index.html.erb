<!-- HOT OFFERS -->
<section id="offers">
<h2 class="title">Characters</h2>
  <div class="container-mine-vert">
    <div class="character-grid">

      <% @offers.each do |item| %>
        <div class="character-card">
          <div class="character-image-container">

          </div>

          <div class="character-info">
            <h2 class="character-name-h center">
              <%= item.phone.name %>
            </h2>
            <p> <%= item.storage%> </p>
            <p> <%= item.color %> </p>
            <p> <%= item.price %> </p>
          </div>
            <div class="profile-link">
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="profile-link">
    </div>
  </div>
</section>

