

<!-- HOT OFFERS -->
<section id="offers">
<h2 class="title">Featured</h2>
  <div class="container-mine-vert">
    <div class="character-grid">

      <% @featured.sample(6).each do |item| %>
        <div class="character-card">

          <div class="character-info">
            <h2 class="character-name-h center">
              <%= item.phone.name %>
            </h2>
            <p> <%= item.storage%> </p>
            <p> <%= item.color %> </p>
            <p> <%= item.price %> </p>
                <div class="profile-link">
                </div>
          </div>
          <div class="profile-link">
            <%= link_to "View", device_path(item), class: "button is-link" %>

            <% if session[:cart]&.include?(item.id) %>
              <%= button_to "Remove", remove_from_cart_path(item), method: :delete, class: "button is-link" %>
            <% else %>
              <%= button_to "Add to Cart", add_to_cart_path(item), method: :post, class: "button is-link" %>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>


  </div>
</section>

