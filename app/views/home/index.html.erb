

<!-- HOT OFFERS -->
<section id="offers">
<h2 class="title">Featured</h2>
  <div class="container-mine-vert">
    <div class="character-grid">

      <% @featured.sample(5).each do |item| %>
        <div class="character-card">

          <div class="character-info">
            <h2 class="character-name-h center">
              <%= item.phone.name %>
            </h2>
            <p> <%= item.storage%> </p>
            <p> <%= item.color %> </p>
            <p> <%= item.price %> </p>
                <div class="profile-link">
                </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="profile-link">
    </div>
  </div>
</section>

