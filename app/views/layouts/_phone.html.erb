
  <aside>
    <% if phone.image.present? %>
      <p><%= image_tag phone.image.variant(resize_to_limit: [285, 285]).processed  %></p>
    <% end %>
    <h3><%= link_to phone.name, phone %></h3>
    <p>Price: <%= number_to_currency phone.price_cents / 100.0 %></p>
    <p><%= phone.description %></p>
    <% if cart.include? phone %>
      <%= button_to cart_path(phone), method: :delete do %>
        Remove from cart
        <% end %>
    <% else %>
      <%= form_with url: cart_index_path do %>
        <%= hidden_field_tag(:id, phone.id) %>
        <%= button_tag "Add to cart"%>
      <% end %>
    <% end %>
  </aside>