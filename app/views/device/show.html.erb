<!-- app/views/devices/show.html.erb -->

  <div class="center">
    <h2 class="title"><%= @device.phone.name %></h2>

    <%# — Basic Device Details always show, since storage/color/price are required %>
    <div class="character-card">
      <div class="character-info">
        <p><strong>Brand:</strong> <%= @device.phone.brand_name %></p>
        <p><strong>Storage:</strong> <%= @device.storage %></p>
        <p><strong>Color:</strong> <%= @device.color %></p>
        <p><strong>Price:</strong> <%= number_with_precision(@device.price, precision: 2) %></p>
      </div>
    </div>
  </div>


<section class="container-mine-vert">


  <%# — Phone Specs header only if any spec exists %>
  <% if @device.phone.battery_type.present? ||
        @device.phone.platform_os.present? ||
        @device.phone.network_technology.present? ||
        @device.phone.display_type.present? ||
        @device.phone.launch_announced.present? ||
        @device.phone.body_dimensions.present? ||
        @device.phone.memory_internal.present? ||
        @device.phone.sound_audio_jack.present? ||
        @device.phone.comms_wlan.present? ||
        @device.phone.features_sensors.present? ||
        @device.phone.cameras_main_type.present? %>
    <h3 class="title">Phone Specs</h3>
  <% end %>

  <%# Battery %>
  <% if @device.phone.battery_type.present? || @device.phone.battery_charging.any? %>
    <div class="character-card">
      <div class="character-info">
        <p><strong>Battery:</strong> <%= @device.phone.battery_type %>
          <% if @device.phone.battery_charging.any? %>
            (<%= @device.phone.battery_charging.join(", ") %>)
          <% end %>
        </p>
      </div>
    </div>
  <% end %>

  <%# Platform %>
  <% if [@device.phone.platform_os,
         @device.phone.platform_chipset,
         @device.phone.platform_cpu,
         @device.phone.platform_gpu].any?(&:present?) %>
    <div class="character-card">
      <div class="character-info">
        <% if @device.phone.platform_os.present? %>
          <p><strong>OS:</strong> <%= @device.phone.platform_os %></p>
        <% end %>
        <% if @device.phone.platform_chipset.present? %>
          <p><strong>Chipset:</strong> <%= @device.phone.platform_chipset %></p>
        <% end %>
        <% if @device.phone.platform_cpu.present? %>
          <p><strong>CPU:</strong> <%= @device.phone.platform_cpu %></p>
        <% end %>
        <% if @device.phone.platform_gpu.present? %>
          <p><strong>GPU:</strong> <%= @device.phone.platform_gpu %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Network %>
  <% if [@device.phone.network_technology,
         @device.phone.network_speed].any?(&:present?) ||
        @device.phone.network_2g.any? ||
        @device.phone.network_3g.any? ||
        @device.phone.network_4g.any? ||
        @device.phone.network_5g.any? %>
    <div class="character-card">
      <div class="character-info">
        <% if @device.phone.network_technology.present? %>
          <p><strong>Technology:</strong> <%= @device.phone.network_technology %></p>
        <% end %>
        <% if @device.phone.network_speed.present? %>
          <p><strong>Speed:</strong> <%= @device.phone.network_speed %></p>
        <% end %>
        <% if @device.phone.network_2g.any? %>
          <p><strong>2G Bands:</strong> <%= @device.phone.network_2g.join(", ") %></p>
        <% end %>
        <% if @device.phone.network_3g.any? %>
          <p><strong>3G Bands:</strong> <%= @device.phone.network_3g.join(", ") %></p>
        <% end %>
        <% if @device.phone.network_4g.any? %>
          <p><strong>4G Bands:</strong> <%= @device.phone.network_4g.join(", ") %></p>
        <% end %>
        <% if @device.phone.network_5g.any? %>
          <p><strong>5G Bands:</strong> <%= @device.phone.network_5g.join(", ") %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Display %>
  <% if [@device.phone.display_type,
         @device.phone.display_size,
         @device.phone.display_resolution,
         @device.phone.display_protection].any?(&:present?) %>
    <div class="character-card">
      <div class="character-info">
        <% if @device.phone.display_type.present? %>
          <p><strong>Type:</strong> <%= @device.phone.display_type %></p>
        <% end %>
        <% if @device.phone.display_size.present? %>
          <p><strong>Size:</strong> <%= @device.phone.display_size %></p>
        <% end %>
        <% if @device.phone.display_resolution.present? %>
          <p><strong>Resolution:</strong> <%= @device.phone.display_resolution %></p>
        <% end %>
        <% if @device.phone.display_protection.present? %>
          <p><strong>Protection:</strong> <%= @device.phone.display_protection %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Launch %>
  <% if [@device.phone.launch_announced,
         @device.phone.launch_released,
         @device.phone.launch_status].any?(&:present?) %>
    <div class="character-card">
      <div class="character-info">
        <% if @device.phone.launch_announced.present? %>
          <p><strong>Announced:</strong> <%= @device.phone.launch_announced %></p>
        <% end %>
        <% if @device.phone.launch_released.present? %>
          <p><strong>Released:</strong> <%= @device.phone.launch_released %></p>
        <% end %>
        <% if @device.phone.launch_status.present? %>
          <p><strong>Status:</strong> <%= @device.phone.launch_status %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Body %>
  <% if [@device.phone.body_dimensions,
         @device.phone.body_weight,
         @device.phone.body_build,
         @device.phone.body_sim].any?(&:present?) %>
    <div class="character-card">
      <div class="character-info">
        <% if @device.phone.body_dimensions.present? %>
          <p><strong>Dimensions:</strong> <%= @device.phone.body_dimensions %></p>
        <% end %>
        <% if @device.phone.body_weight.present? %>
          <p><strong>Weight:</strong> <%= @device.phone.body_weight %></p>
        <% end %>
        <% if @device.phone.body_build.present? %>
          <p><strong>Build:</strong> <%= @device.phone.body_build %></p>
        <% end %>
        <% if @device.phone.body_sim.present? %>
          <p><strong>SIM:</strong> <%= @device.phone.body_sim %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Memory %>
  <% if @device.phone.memory_internal.present? || @device.phone.memory_card_slot.present? %>
    <div class="character-card">
      <div class="character-info">
        <% if @device.phone.memory_internal.present? %>
          <p><strong>Internal:</strong> <%= @device.phone.memory_internal %></p>
        <% end %>
        <% if @device.phone.memory_card_slot.present? %>
          <p><strong>Card Slot:</strong> <%= @device.phone.memory_card_slot %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Sound %>
  <% if @device.phone.sound_audio_jack.present? || @device.phone.sound_loudspeaker.present? %>
    <div class="character-card">
      <div class="character-info">
        <% if @device.phone.sound_audio_jack.present? %>
          <p><strong>Audio Jack:</strong> <%= @device.phone.sound_audio_jack %></p>
        <% end %>
        <% if @device.phone.sound_loudspeaker.present? %>
          <p><strong>Loudspeaker:</strong> <%= @device.phone.sound_loudspeaker %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Comms %>
  <% if [@device.phone.comms_wlan,
         @device.phone.comms_bluetooth,
         @device.phone.comms_positioning,
         @device.phone.comms_radio,
         @device.phone.comms_usb].any?(&:present?) ||
        @device.phone.comms_nfc != nil %>
    <div class="character-card">
      <div class="character-info">
        <% if @device.phone.comms_wlan.present? %>
          <p><strong>Wi‑Fi:</strong> <%= @device.phone.comms_wlan %></p>
        <% end %>
        <% if @device.phone.comms_bluetooth.present? %>
          <p><strong>Bluetooth:</strong> <%= @device.phone.comms_bluetooth %></p>
        <% end %>
        <% if @device.phone.comms_positioning.present? %>
          <p><strong>Positioning:</strong> <%= @device.phone.comms_positioning %></p>
        <% end %>
        <% unless @device.phone.comms_nfc.nil? %>
          <p><strong>NFC:</strong> <%= @device.phone.comms_nfc ? "Yes" : "No" %></p>
        <% end %>
        <% if @device.phone.comms_radio.present? %>
          <p><strong>Radio:</strong> <%= @device.phone.comms_radio %></p>
        <% end %>
        <% if @device.phone.comms_usb.present? %>
          <p><strong>USB:</strong> <%= @device.phone.comms_usb %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Sensors %>
  <% if @device.phone.features_sensors.present? %>
    <div class="character-card">
      <div class="character-info">
        <p><strong>Sensors:</strong> <%= @device.phone.features_sensors %></p>
      </div>
    </div>
  <% end %>

  <%# Cameras %>
  <% if @device.phone.cameras_main_type.present? ||
        @device.phone.cameras_selfie_type.present? %>
    <h3 class="title">Cameras</h3>
  <% end %>

  <% if @device.phone.cameras_main_type.present? ||
        @device.phone.cameras_main_camera_specs.any? ||
        @device.phone.cameras_main_features.any? ||
        @device.phone.cameras_main_video.any? %>
    <div class="character-card">
      <div class="character-info">
        <% if @device.phone.cameras_main_type.present? %>
          <p><strong>Main Type:</strong> <%= @device.phone.cameras_main_type %></p>
        <% end %>
        <% if @device.phone.cameras_main_camera_specs.any? %>
          <p><strong>Specs:</strong> <%= @device.phone.cameras_main_camera_specs.join(", ") %></p>
        <% end %>
        <% if @device.phone.cameras_main_features.any? %>
          <p><strong>Features:</strong> <%= @device.phone.cameras_main_features.join(", ") %></p>
        <% end %>
        <% if @device.phone.cameras_main_video.any? %>
          <p><strong>Video:</strong> <%= @device.phone.cameras_main_video.join(", ") %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @device.phone.cameras_selfie_type.present? ||
        @device.phone.cameras_selfie_camera_specs.any? ||
        @device.phone.cameras_selfie_features.any? ||
        @device.phone.cameras_selfie_video.any? %>
    <div class="character-card">
      <div class="character-info">
        <% if @device.phone.cameras_selfie_type.present? %>
          <p><strong>Selfie Type:</strong> <%= @device.phone.cameras_selfie_type %></p>
        <% end %>
        <% if @device.phone.cameras_selfie_camera_specs.any? %>
          <p><strong>Specs:</strong> <%= @device.phone.cameras_selfie_camera_specs.join(", ") %></p>
        <% end %>
        <% if @device.phone.cameras_selfie_features.any? %>
          <p><strong>Features:</strong> <%= @device.phone.cameras_selfie_features.join(", ") %></p>
        <% end %>
        <% if @device.phone.cameras_selfie_video.any? %>
          <p><strong>Video:</strong> <%= @device.phone.cameras_selfie_video.join(", ") %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Models %>
  <% if @device.phone.models.any? %>
    <div class="character-card">
      <div class="character-info">
        <p><strong>Models:</strong> <%= @device.phone.models.join(", ") %></p>
      </div>
    </div>
  <% end %>

</section>
